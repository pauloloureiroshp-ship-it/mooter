{
  "name": "mooter-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker serving mooter community hub (delta ingest, stats, models, events).",
  "main": "worker.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.mooter.toml --port 8788",
    "deploy": "wrangler deploy -c wrangler.mooter.toml",
    "deploy:mooter": "wrangler deploy -c wrangler.mooter.toml",
    "deploy:legacy": "wrangler deploy -c wrangler.frugal-legacy.toml",
    "test": "node --test routes/__tests__/*.test.js"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.49.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "wrangler": "^4.83.0"
  }
}
