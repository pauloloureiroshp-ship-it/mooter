# mooter-dashboard — local-only dashboard (127.0.0.1:7820)
# Copy to .env.local for local dev.

# ── Sentry (Sprint 8.2 — optional) ──────────────────────────────────────
# Leave blank to disable all telemetry. When set, errors from the
# dashboard (which is local-only) are forwarded to Sentry.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=mooter-dashboard@0.1.0

# Build-time only (source-map upload). Never commit.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
