{
  "name": "@mooter/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "mooter CLI — Wave 1 Day 5: `mooter pack {list,show,diff,validate}`. See PASTOR §6.3, §10.5. tsx-native runtime (ADR 016), no build step.",
  "bin": {
    "mooter": "./src/index.ts"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "build": "NODE_PATH=node_modules esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=mooter.js --log-level=warning"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "esbuild": "^0.24.0",
    "js-yaml": "^4.1.1",
    "p-limit": "^6.2.0",
    "tsx": "^4.22.3"
  }
}
