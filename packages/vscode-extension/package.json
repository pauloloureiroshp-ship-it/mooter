{
  "name": "mooter-cockpit",
  "displayName": "Mooter — AI Project Cockpit",
  "description": "Operate a Claude Code project from VS Code: resume context, plan work, watch agents and Live Preview, review guarded edits, and see local-first routing decisions. Community project.",
  "version": "0.16.78",
  "publisher": "mooter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pauloloureiroshp-ship-it/mooter.git"
  },
  "homepage": "https://mooter.ai",
  "bugs": {
    "url": "https://github.com/pauloloureiroshp-ship-it/mooter/issues"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "project-cockpit",
    "live-preview",
    "code-review",
    "router",
    "ollama",
    "local-first",
    "llm",
    "developer-tools",
    "telemetry"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B0A09",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "markdown": "github",
  "preview": false,
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Telemetry views remain available in untrusted workspaces. Agent SDK edits and dev-server execution require Workspace Trust; those paths stay disabled until the workspace is trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Needs local filesystem access to read mooter telemetry and run the mooter CLI."
    }
  },
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test src/*.test.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mooter",
          "title": "Mooter",
          "icon": "media/cow.svg"
        }
      ]
    },
    "views": {
      "mooter": [
        {
          "type": "webview",
          "id": "mooterCockpit",
          "name": "Cockpit",
          "when": "!mooter.livePreviewMode"
        },
        {
          "type": "webview",
          "id": "mooterLivePreviewSidebar",
          "name": "Live Preview",
          "contextualTitle": "Mooter — Live Preview",
          "when": "mooter.livePreviewMode"
        }
      ]
    },
    "commands": [
      {
        "command": "mooter.openCockpit",
        "title": "Open Cockpit",
        "category": "Mooter",
        "icon": "$(dashboard)"
      },
      {
        "command": "mooter.newSession",
        "title": "New Claude Code Session",
        "category": "Mooter"
      },
      {
        "command": "mooter.openSessionTab",
        "title": "Open Session Tab (focus the CC tab for a session)",
        "category": "Mooter"
      },
      {
        "command": "mooter.refresh",
        "title": "Refresh Data",
        "category": "Mooter",
        "icon": "$(refresh)"
      },
      {
        "command": "mooter.openLivePreview",
        "title": "Open Live Preview ⚡",
        "category": "Mooter",
        "icon": "$(preview)"
      },
      {
        "command": "mooter.focusLivePreviewSidebar",
        "title": "Open Live Preview Controls",
        "category": "Mooter",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "mooter.showAdvancedViews",
        "title": "Show advanced views (Setup · Agents · Decisions · Doctor)",
        "category": "Mooter"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mooter.refresh",
          "when": "view == mooterCockpit",
          "group": "navigation"
        },
        {
          "command": "mooter.openLivePreview",
          "when": "view == mooterCockpit",
          "group": "navigation"
        },
        {
          "command": "mooter.openLivePreview",
          "when": "view == mooterLivePreviewSidebar",
          "group": "navigation@1"
        },
        {
          "command": "mooter.refresh",
          "when": "view == mooterLivePreviewSidebar",
          "group": "navigation@2"
        },
        {
          "command": "mooter.openCockpit",
          "when": "view == mooterLivePreviewSidebar",
          "group": "navigation@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mooter.openLivePreview",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m"
      }
    ],
    "configuration": {
      "title": "Mooter",
      "properties": {
        "mooter.trackerPort": {
          "type": "number",
          "default": 7821,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port of the local mooter savings tracker."
        },
        "mooter.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the mooter item in the status bar."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "mooter.gettingStarted",
        "title": "Get started with Mooter",
        "description": "Set up the engine, open the project cockpit, and review a guarded change in three steps.",
        "steps": [
          {
            "id": "engine",
            "title": "Install the Mooter engine",
            "description": "Mooter's deterministic local-first engine routes prompts and records local evidence for the cockpit. Install it once, then open the cockpit to inspect the project.\n[Open Cockpit](command:mooter.openCockpit)",
            "media": {
              "markdown": "walkthrough/engine.md"
            }
          },
          {
            "id": "open",
            "title": "Open the project cockpit",
            "description": "Resume session context, inspect roadmap and WIP, see routing decisions, and watch agents. Open Live Preview when you want to inspect or change the app.\n[Open Cockpit](command:mooter.openCockpit)",
            "media": {
              "markdown": "walkthrough/open.md"
            }
          },
          {
            "id": "launch",
            "title": "Review and publish a change",
            "description": "Live Preview separates preview-first local edits, trusted Agent SDK edits, Security Review, selective Commit + Push, and confirmed Vercel deploy. Each action names what it can change.\n[Open Live Preview](command:mooter.openLivePreview)",
            "media": {
              "markdown": "walkthrough/launch.md"
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@babel/parser": "^8.0.0"
  }
}
