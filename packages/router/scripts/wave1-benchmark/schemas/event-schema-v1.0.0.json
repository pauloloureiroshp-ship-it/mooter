{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event-schema-v1.0.0",
  "title": "Mooter benchmark RAW_RESULTS row (BenchEvent)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "lineage",
    "prompt_id",
    "arm",
    "block",
    "expected_pack",
    "expected_tier_floor",
    "model_used",
    "tier_routed",
    "pack_routed",
    "pack_confidence",
    "latency_classifier_ms",
    "latency_llm_ms",
    "latency_total_ms",
    "tokens_input",
    "tokens_output",
    "tokens_total",
    "cost_micros",
    "response",
    "judge_scores",
    "quality_score",
    "judge_run_id",
    "judge_seed_position",
    "pack_correct",
    "tier_appropriate",
    "would_higher_tier_help",
    "deterministic",
    "status",
    "error",
    "timestamp"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "event_type": { "const": "bench" },
    "lineage": { "$ref": "lineage-schema-v1.0.0" },
    "prompt_id": { "type": "string", "pattern": "^P[0-9]{3}$" },
    "arm": { "enum": ["A", "B", "C"] },
    "block": { "type": "string" },
    "expected_pack": { "type": "string" },
    "expected_tier_floor": { "enum": ["T0", "T1", "T2", "T3"] },
    "model_used": { "type": "string" },
    "tier_routed": { "type": ["string", "null"], "enum": ["T0", "T1", "T2", "T3", null] },
    "pack_routed": { "type": ["string", "null"] },
    "pack_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "latency_classifier_ms": { "type": "number", "minimum": 0 },
    "latency_llm_ms": { "type": "number", "minimum": 0 },
    "latency_total_ms": { "type": "number", "minimum": 0 },
    "tokens_input": { "type": "integer", "minimum": 0 },
    "tokens_output": { "type": "integer", "minimum": 0 },
    "tokens_total": { "type": "integer", "minimum": 0 },
    "cost_micros": { "type": "integer", "minimum": 0 },
    "response": { "type": "string" },
    "judge_scores": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["correctness", "completeness", "relevance", "actionability", "hallucination"],
      "properties": {
        "correctness": { "type": "number", "enum": [0, 0.5, 1] },
        "completeness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "relevance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "actionability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "hallucination": { "type": "integer", "enum": [0, 1] }
      }
    },
    "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "judge_run_id": { "type": ["string", "null"] },
    "judge_seed_position": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
    "pack_correct": { "type": ["boolean", "null"] },
    "tier_appropriate": { "type": ["boolean", "null"] },
    "would_higher_tier_help": { "type": ["boolean", "null"] },
    "deterministic": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["ran", "passed", "kind", "detail"],
      "properties": {
        "ran": { "type": "boolean" },
        "passed": { "type": ["boolean", "null"] },
        "kind": { "type": ["string", "null"] },
        "detail": { "type": "string" }
      }
    },
    "status": { "enum": ["ok", "failed"] },
    "error": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "minLength": 20 }
  }
}
