  "routing_decision_matrix": {
    "_note": "This matrix maps (task_type, hardware_tier, plan) → optimal model. Used by classify.js and budget-engine.js.",
    "trivial_edit": {
      "any_hw": "inline_opus",
      "note": "Trivial edits (typo, rename, color) are fastest inline. Don't pay subagent spawn overhead."
    },
    "summarize": {
      "gpu-high": "gemma4:e4b",
      "gpu-mid": "gemma4:e4b",
      "gpu-low": "qwen2.5:3b",
      "cpu-only": "claude-haiku-4-5"
    },
    "commit_message": {
      "any_hw_with_api_key": "claude-haiku-4-5",
      "any_hw_no_api_key": "gemma4:e4b"
    },
    "bug_investigation": {
      "any_plan": "claude-sonnet-4-6",
      "note": "Sonnet outperformed Opus in A/B test for structured reasoning (P6, P9, P10)"
    },
    "architecture": {
      "any_plan": "claude-opus-4-6",
      "note": "Never downgrade architecture decisions. Guardrail: always T3."
    },
    "security_review": {
      "any_plan": "claude-opus-4-6",
      "note": "Security reviews are HIGH_RISK. Always T3."
    },
    "pre_merge": {
      "any_plan": "final-reviewer (opus)",
      "note": "Never skip. Guardrail: always spawn final-reviewer."
    }
  },

  "learning_signals": {
    "_note": "How we learn from user behavior to improve the routing matrix over time.",
    "positive_signals": [
      "User moves to next topic within 30-180s (implicit acceptance)",
      "No retry of same prompt (no correction needed)",
      "Explicit thumbs up / mooter-good",
      "Shadow mode: primary response judged better or tie"
    ],
    "negative_signals": [
      "User retries same prompt within 30s (correction/dissatisfaction)",
      "User manually escalates tier ('use opus for this')",
      "Explicit thumbs down / mooter-bad",
      "Shadow mode: shadow response judged better"
    ],
    "calibration_loop": "auto-feedback.js → outcomes.jsonl → backtest.js → pattern updates → new classify.js version → algorithm_versions table"
  }
}
