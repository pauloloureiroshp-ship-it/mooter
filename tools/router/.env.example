ANTHROPIC_API_KEY=sk-ant-...your-key-here

# Hub URL — prefer MOOTER_HUB_URL; FRUGAL_HUB_URL accepted for 30-day backward-compat.
MOOTER_HUB_URL=https://mooter-hub.frugal-hub.workers.dev
# FRUGAL_HUB_URL=https://frugal-hub.frugal-hub.workers.dev  # legacy fallback

