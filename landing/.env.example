# mooter-landing — environment variable template
# Copy to .env.local for local dev; set in Vercel Project → Settings → Environment Variables for prod.

# ── Supabase (required) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Site (optional overrides) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mooter.ai
NEXT_PUBLIC_MOOTER_HUB_URL=https://mooter-hub.frugal-hub.workers.dev

# ── Sentry (Sprint 8.1 — optional but strongly recommended in prod) ─────
# When unset, Sentry SDK init is a no-op and nothing ships to the network.
# NEXT_PUBLIC_SENTRY_DSN is client-safe (DSNs are public-by-design in Sentry).
NEXT_PUBLIC_SENTRY_DSN=
# Release tag used for issue grouping + source-map association.
NEXT_PUBLIC_APP_VERSION=mooter-landing@0.1.0
# Build-time only — required to upload source maps. Never commit.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
