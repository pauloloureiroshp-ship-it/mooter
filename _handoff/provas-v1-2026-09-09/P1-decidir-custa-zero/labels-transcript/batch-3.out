{"labels":[{"id":"n27","tier":"T0","reason":"Troca mecânica de elementos, sem análise ou risco indicado."},{"id":"n28","tier":"T1","reason":"Registar informação em dois destinos é uma pequena tarefa textual."},{"id":"n29","tier":"T3","reason":"Avaliar prontidão para deploy de funcionalidades em produção."},{"id":"n30","tier":"T2","reason":"Interpretar teste A/B, comparar resultados e recomendar melhorias."},{"id":"n31","tier":"T2","reason":"Identificar trabalho pendente e coordenar a continuação exige planeamento."},{"id":"n32","tier":"T2","reason":"Comparar concorrência, avaliar resultados e recomendar próximos passos."},{"id":"n33","tier":"T2","reason":"Avaliar funcionamento e planear uma auditoria autónoma do trabalho."},{"id":"n34","tier":"T2","reason":"Inspecionar recursos disponíveis e fundamentar uma recomendação."},{"id":"n35","tier":"T0","reason":"Pedido de comunicação quando o trabalho terminar."},{"id":"n36","tier":"T0","reason":"Coordenação simples sobre o próximo passo, sem investigação explícita."},{"id":"n37","tier":"T0","reason":"Correção pontual de um passo, sem complexidade ou risco indicado."},{"id":"n38","tier":"T2","reason":"Preparar handoff com plano de execução autónoma exige decomposição."},{"id":"n39","tier":"T3","reason":"Escrever testes e integrá-los no CI força T3."}]}
