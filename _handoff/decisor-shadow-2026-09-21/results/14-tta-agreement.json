 "rule": {
  "definition": "por item TTA (4 rotacoes r=0..3): voto_r = argmax da distribuicao da rotacao r (em espaco de tier); tier_final = argmax da media (o que o ficheiro ja tem); votos = #{r : voto_r == tier_final}; nivel = votos/4 in {1/4, 2/4, 3/4, 4/4}. p_agree = votos/4 e a confianca candidata.",
  "metrics": "por corpus: n e acc por nivel (4/4, 3/4, 2/4, 1/4 se existir); ECE (10 bins) com p = p_agree; comparacao com ECE_v0 (0,110/0,124/0,146) e ECE_tta (0,187/0,196/0,221); acc media por nivel vs p_agree (calibracao bruta em 4 pontos); tambem a acc do v0 (rotacao 0) nos mesmos niveis.",
  "hypothesis": "a concordancia entre rotacoes e um sinal de confianca melhor que p_max: a acc cresce com o nivel, e p_agree e mais bem calibrada que p_max da media.",
  "confirmed_if": "acc(4/4) > acc(3/4) > acc(2/4) em AMBOS os corpora de exploracao (niveis com n >= 5; niveis com n < 5 nao contam para a monotonia) E ECE(p_agree) < ECE_tta em ambos",
  "refuted_if": "a monotonia falha em ambos, OU ECE(p_agree) >= ECE_tta em ambos",
  "otherwise": "ENTRE",
  "not_a_gate": "nada disto entra no mp4; se confirmar, e uma ideia de confianca para um pre-registo proprio (e exige TTA no shadow: 4 chamadas).",
  "script": "14-tta-agreement.mjs — le so os ficheiros TTA em disco; nao corre modelo; nao escreve texto."
